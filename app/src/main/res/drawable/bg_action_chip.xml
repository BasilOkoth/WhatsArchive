<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/wa_primary_soft" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/wa_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wa_surface" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/wa_border" />
        </shape>
    </item>
</selector>
