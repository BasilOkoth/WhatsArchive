<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/premiumRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/wa_bg"
    android:paddingLeft="16dp"
    android:paddingTop="14dp"
    android:paddingRight="16dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="ChatArchive logo"
            android:src="@drawable/ic_whatsarchive" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-medium"
                android:text="ChatArchive"
                android:textColor="@color/wa_primary_dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A product of Elimara Technologies Limited"
                android:textColor="@color/wa_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/lockButton"
            style="@style/WaButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Set app lock" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <TextView
            android:id="@+id/accessStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_off"
            android:text="Checking capture status…"
            android:textColor="@color/wa_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/archiveCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="0 messages • 0 conversations"
            android:textColor="@color/wa_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/searchBox"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search"
        android:hint="Search conversation, sender or message"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:singleLine="true"
        android:textColor="@color/wa_text"
        android:textColorHint="@color/wa_text_muted"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/statusSpinner"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_search" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/openAccessButton"
                style="@style/WaButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Notification access" />

            <Button
                android:id="@+id/proButton"
                style="@style/WaButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginLeft="8dp"
                android:text="Upgrade to Pro" />

            <Button
                android:id="@+id/backupButton"
                style="@style/WaButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginLeft="8dp"
                android:text="Encrypted backup" />

            <Button
                android:id="@+id/restoreButton"
                style="@style/WaButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginLeft="8dp"
                android:text="Restore / Import" />

            <Button
                android:id="@+id/exportButton"
                style="@style/WaButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginLeft="8dp"
                android:text="JSON export" />

            <Button
                android:id="@+id/deleteButton"
                style="@style/WaButton.Danger"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginLeft="8dp"
                android:text="Clear archive" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        style="@style/WaSectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:text="CONVERSATIONS — TAP TO OPEN ALL MESSAGES" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/contactList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="30dp"
            android:text="No matching conversations yet.
Incoming supported WhatsApp notifications will appear here."
            android:textAlignment="center"
            android:textColor="@color/wa_text_muted"
            android:textSize="14sp" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:text="ChatArchive • Elimara Technologies Limited • Free + Lifetime Pro • v0.6.0"
        android:textColor="@color/wa_text_muted"
        android:textSize="10sp" />
</LinearLayout>
