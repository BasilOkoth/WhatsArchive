<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wa_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="56dp"
        android:contentDescription="ChatArchive logo"
        android:src="@drawable/ic_whatsarchive" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Unlock ChatArchive"
        android:textColor="@color/wa_primary_dark"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/lockPin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_search"
        android:gravity="center"
        android:hint="PIN"
        android:inputType="numberPassword"
        android:maxLength="8"
        android:singleLine="true" />

    <Button
        android:id="@+id/unlockPinButton"
        style="@style/WaButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:text="Unlock with PIN" />

    <Button
        android:id="@+id/unlockBiometricButton"
        style="@style/WaButton.Secondary"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:text="Use biometrics" />

    <Button
        android:id="@+id/exitLockButton"
        style="@style/WaButton.Secondary"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:text="Exit" />
</LinearLayout>
