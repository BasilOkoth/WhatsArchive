<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/contactSender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/wa_sender_name"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/contactCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_contact_count"
            android:fontFamily="sans-medium"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/wa_primary_dark"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/contactLatest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/wa_message_body"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/contactMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textColor="@color/wa_text_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/contactWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:background="@drawable/bg_badge_warning"
        android:fontFamily="sans-medium"
        android:textColor="@color/wa_warning"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:fontFamily="sans-medium"
        android:text="Open conversation  ›"
        android:textColor="@color/wa_primary_dark"
        android:textSize="11sp" />

</LinearLayout>
